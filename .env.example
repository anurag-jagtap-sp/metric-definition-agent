# Copy to .env and fill in. Never commit .env.

# Confluence (Atlassian API token from id.atlassian.com/manage-profile/security/api-tokens)
CONFLUENCE_URL=https://your-site.atlassian.net/wiki
CONFLUENCE_USERNAME=
CONFLUENCE_API_TOKEN=
# Comma-separated space keys and optional labels
CONFLUENCE_SPACES=IT,BT,REVOPS,CSO
CONFLUENCE_LABELS=

# Gemini via Vertex AI (authenticate with: gcloud auth application-default login)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_PRO_MODEL=
GEMINI_FLASH_MODEL=
GEMINI_EMBED_MODEL=

# GitHub bot (can open PRs, cannot approve or merge)
GITHUB_TOKEN=
GITHUB_REPO=anurag-jagtap-sp/metric-definition-agent

# BigQuery (read-only service account on authorized views)
BIGQUERY_PROJECT=
BIGQUERY_DATASETS=

# Local DuckDB for development and unit tests
DUCKDB_PATH=../data/dev.duckdb
